# --- IDEs & OS ---
.idea/
.vscode/
*.iml
*.swp
.DS_Store
Thumbs.db
*.log
local.properties

# --- JAVA / SPRING BOOT (Backend) ---
**/target/
**/build/
**/*.class
**/out/
.mvn/wrapper/maven-wrapper.jar
# No ignoramos mvnw para permitir builds en otros entornos

# --- ANDROID (Mobile) ---
**/capture/
**/.externalNativeBuild
**/.cxx
**/*.apk
**/*.ap_
**/*.dex
**/captures/
**/.gradle/

# --- NODE / REACT (Frontend) ---
**/node_modules/
**/dist/
**/build/
**/env/
.env
.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- PYTHON / ODOO ---
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
**/.venv/
**/venv/
**/ENV/

# --- DOCKER & DATABASES ---
# Carpetas de datos persistentes (crucial para evitar commits masivos)
**/pgdata/
**/mysql-data/
**/data/
**/db_data/
**/odoo_data/
**/odoo/db_data/
**/*.db
**/*.sqlite3
# Ignora archivos de volúmenes de Docker específicos
**/var/lib/postgresql/data/*

# --- FIREBASE ---
.firebase/
**/firebase-debug.log
**/firestore-debug.log
**/ui-debug.log

# --- SPRING TOOLSUITE (IDE) ---
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache